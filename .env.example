# ─── Core Authentication ───────────────────────────────────────
NEXTAUTH_SECRET=your-secret-here
NEXTAUTH_URL=https://www.aldwycheuropeancapital.com
JWT_SECRET=your-secret-here

# ─── Database ──────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/?appName=Cluster0
MONGODB_DB=aldwych

# ─── Public URLs ───────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://www.aldwycheuropeancapital.com
NEXT_PUBLIC_APP_URL=https://www.aldwycheuropeancapital.com

# ─── Security ─────────────────────────────────────────────────
PII_ENCRYPTION_KEY=64-hex-chars-here

# ─── Cron / Scheduled Jobs ────────────────────────────────────
CRON_SECRET=a-random-secret-for-cron-endpoints

# ─── Logging ──────────────────────────────────────────────────
LOG_LEVEL=info

# ─── Node ─────────────────────────────────────────────────────
NODE_ENV=production
