{
  "version": 2,
  "framework": null,
  "installCommand": "pnpm install",
  "buildCommand": "npx expo export --platform web",
  "outputDirectory": "dist",
  "functions": {
    "api/index.ts": {
      "runtime": "@vercel/node@3",
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.ts" },
    { "source": "/manus-storage/(.*)", "destination": "/api/index.ts" }
  ]
}
